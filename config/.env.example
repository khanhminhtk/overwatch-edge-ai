SERVICE_HOST=127.0.0.1

# MinIO
MINIO_IMAGE=minio/minio:latest
MINIO_CONTAINER_NAME=minio
MINIO_RESTART=unless-stopped
MINIO_DATA_DIR=/home/minhtk/code/overwatch-edge-ai/worktree/backend_nexus/data/minio
MINIO_HOST_IP=${SERVICE_HOST}
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=supersecretpassword
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=supersecretpassword
MINIO_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_API_DOCKER_PORT=9000
MINIO_CONSOLE_DOCKER_PORT=9001
MINIO_BROWSER_REDIRECT_URL=http://${SERVICE_HOST}:9001
MINIO_SERVER_URL=http://${SERVICE_HOST}:9000
MINIO_USE_SSL=false
MINIO_SERVICE_PORT=50052
MINIO_SERVICE_ID_MONITORING_PORT=18080
MINIO_SERVICE_METRIC_GRPC_PORT=19090
MINIO_DEFAULT_BUCKET=default
MINIO_MODELCHECKPOINT_BUCKET=model-checkpoint
MINIO_DATA_BUCKET=data
MINIO_DATARETRAIN_BUCKET=data-retrain
MINIO_KAFKA_UPLOAD_TOPIC=minio.upload.request
MINIO_KAFKA_UPLOAD_GROUP=service-minio-upload
MINIO_KAFKA_RESULT_TOPIC=minio.upload.result
MINIO_PRESIGN_EXPIRY_SECONDS=3600

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=overwatch
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DOCKER_PORT=5432

# Kafka
KAFKA_IMAGE=bitnamilegacy/kafka:latest
KAFKA_CONTAINER_NAME=kafka
KAFKA_RESTART=unless-stopped
KAFKA_USER=0:0
KAFKA_DATA_DIR=/home/minhtk/code/overwatch-edge-ai/worktree/backend_nexus/data/kafka
KAFKA_HOST_IP=${SERVICE_HOST}
KAFKA_EXTERNAL_PORT=9092
KAFKA_CFG_NODE_ID=0
KAFKA_CFG_PROCESS_ROLES=controller,broker
KAFKA_CFG_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093
KAFKA_CFG_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092
KAFKA_CFG_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
KAFKA_CFG_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_CFG_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_CFG_CONTROLLER_QUORUM_VOTERS=0@kafka:9093

# Triton
TRITON_IMAGE=nvcr.io/nvidia/tritonserver:23.06-py3
TRITON_CONTAINER_NAME=triton_overwatch
TRITON_RESTART=unless-stopped
TRITON_BIND_HOST=${SERVICE_HOST}
TRITON_HTTP_PORT=8000
TRITON_GRPC_PORT=8001
TRITON_METRICS_PORT=8002
TRITON_LOG_VERBOSE=0
TRITON_SHM_SIZE=1g
TRITON_GPU_COUNT=all
# Repository-local ONNX hand-off: export daemon writes here and Docker builders mount it.
ONNX_EXPORT_DIR=artifacts/onnx
TRITON_MODEL_VERSION=1
TRITON_DETECTOR_ONNX_FILE=detection.onnx
TRITON_RECOGNIZER_ONNX_FILE=recognizer.onnx
TRITON_DETECTOR_PLAN_FILE=detection.plan
TRITON_RECOGNIZER_PLAN_FILE=recognizer.plan
TRITON_DETECTOR_WEIGHTS_PATH=data/checkpoint/yolo/weights/best.pt
TRITON_RECOGNIZER_WEIGHTS_PATH=data/checkpoint_recognizer/best_cer.pt

# MLflow
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:v3.12.0
MLFLOW_CONTAINER_NAME=mlflow_overwatch
MLFLOW_RESTART=unless-stopped
MLFLOW_BIND_HOST=${SERVICE_HOST}
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MLFLOW_S3_IGNORE_TLS=false
MLFLOW_ARTIFACT_BUCKET=mlflow
AWS_DEFAULT_REGION=us-east-1

# Monitoring stack
GRAFANA_IMAGE=grafana/grafana:latest
GRAFANA_RESTART=unless-stopped
GRAFANA_BIND_HOST=${SERVICE_HOST}
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_DATASOURCES_FILE=./config/monitoring/grafana/datasources.yaml

LOKI_IMAGE=grafana/loki:2.9.4
LOKI_RESTART=unless-stopped
LOKI_BIND_HOST=${SERVICE_HOST}
LOKI_PORT=3100
LOKI_LOG_LEVEL=info
LOKI_INDEX_DIR=/tmp/loki/index
LOKI_CACHE_DIR=/tmp/loki/cache
LOKI_CHUNKS_DIR=/tmp/loki/chunks
LOKI_COMPACTOR_DIR=/tmp/loki/boltdb-shipper-compactor
LOKI_RETENTION_PERIOD=720h
LOKI_CONFIG_FILE=./config/monitoring/loki/loki-config.yaml

PROMTAIL_IMAGE=grafana/promtail:2.9.4
PROMTAIL_RESTART=unless-stopped
PROMTAIL_CONFIG_FILE=./config/monitoring/promtail/promtail-config.yaml
PROMTAIL_HTTP_LISTEN_PORT=9080
PROMTAIL_POSITIONS_FILE=/tmp/promtail/positions.yaml
PROMTAIL_PUSH_URL=http://loki:3100/loki/api/v1/push
PROMTAIL_JOB_NAME=app_logs
PROMTAIL_SERVICE_NAME=rag_imtotext_texttoim
PROMTAIL_LOG_PATH=/var/log/chatbot/*.log
CHATBOT_LOG_DIR=./logs
APP_ENV=dev

PROMETHEUS_IMAGE=prom/prometheus:latest
PROMETHEUS_RESTART=unless-stopped
PROMETHEUS_BIND_HOST=${SERVICE_HOST}
PROMETHEUS_PORT=9090
PROMETHEUS_CONFIG_FILE=./config/monitoring/prometheus/prometheus.yml
PROMETHEUS_RULES_DIR=./config/monitoring/prometheus/rules
PROMETHEUS_EXTRA_HOST=host.docker.internal:host-gateway

ALERTMANAGER_IMAGE=prom/alertmanager:latest
ALERTMANAGER_RESTART=unless-stopped
ALERTMANAGER_BIND_HOST=${SERVICE_HOST}
ALERTMANAGER_PORT=9093
ALERTMANAGER_CONFIG_FILE=./config/monitoring/alertmanager/alertmanager.yml
