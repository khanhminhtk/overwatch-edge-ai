name: "detector"
platform: "onnxruntime_onnx"
default_model_filename: "detection.onnx"

max_batch_size: 0

input [
  {
    # max_batch_size: 0 means this includes the batch dimension. The runtime
    # sends one RGB, normalized CHW image as [1, 3, 640, 640].
    name: "images"
    data_type: TYPE_FP32
    dims: [-1, 3, -1, -1]
  }
]

output [
  {
    # YOLO export: [batch, channels, anchors]. Runtime validates the returned
    # dynamic shape before decoding cx, cy, width, height and confidences.
    name: "output0"
    data_type: TYPE_FP32
    dims: [-1, -1, -1]
  }
]

instance_group [
  {
    kind: KIND_CPU
    count: 1
  }
]
version_policy {
  specific {
    versions: [1]
  }
}
