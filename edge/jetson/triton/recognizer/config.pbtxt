name: "recognizer"
platform: "onnxruntime_onnx"
default_model_filename: "recognizer.best_cer.onnx"

max_batch_size: 0

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [-1, -1, 3, 64, 64]
  }
]

output [
  {
    name: "logits"
    data_type: TYPE_FP32
    dims: [-1, -1, 192]
  }
]

instance_group [
  {
    kind: KIND_CPU
    count: 1
  }
]
version_policy {
  specific {
    versions: [1]
  }
}
