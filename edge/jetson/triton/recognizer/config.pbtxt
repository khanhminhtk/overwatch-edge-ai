name: "recognizer"
platform: "tensorrt_plan"
default_model_filename: "recognizer.plan"

max_batch_size: 8

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [16, 3, 64, 64]
  }
]

output [
  {
    name: "logits"
    data_type: TYPE_FP32
    dims: [16, -1]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]

dynamic_batching {
  preferred_batch_size: [2, 4, 8]
  max_queue_delay_microseconds: 300
}
