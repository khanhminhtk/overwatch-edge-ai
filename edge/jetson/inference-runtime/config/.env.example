# Triton Inference Server
triton_url=localhost:8001
triton_detector_model_name=detector
triton_detector_model_version=1
triton_recognizer_model_name=recognizer
triton_recognizer_model_version=1

# Video Source
# Choose exactly one source type: camera, stream_url, image_path, video_path.
video_source_type=camera
video_camera_index=0
video_stream_url=
video_image_path=
video_video_path=
video_width=640
video_height=480
video_fps=30

# Save full frames by inference quality; duplicate-like frames are skipped.
capture_enabled=true
capture_success_output_dir=data/success
capture_fail_output_dir=data/fail
capture_success_min_detection_confidence=0.30
capture_success_min_ocr_confidence=0.70
capture_fail_max_detection_confidence=0.30
capture_fail_max_ocr_confidence=0.70
capture_min_frame_difference=0.12
capture_min_save_interval_seconds=5

# Inference model input/output settings
detector_input_width=640
detector_input_height=640
detector_confidence_threshold=0.25
detector_nms_threshold=0.45
recognizer_num_patches=16
recognizer_patch_width=64
recognizer_patch_height=64
recognizer_mean_r=0.485
recognizer_mean_g=0.456
recognizer_mean_b=0.406
recognizer_std_r=0.229
recognizer_std_g=0.224
recognizer_std_b=0.225
recognizer_vocabulary=0123456789aàáảãạăằắẳẵặâầấẩẫậbcdđeèéẻẽẹêềếểễệghiìíỉĩịklmnoòóỏõọôồốổỗộơờớởỡợpqrstuùúủũụưừứửữựvxyAÀÁẢÃẠĂẰẮẲẴẶÂẦẤẨẪẬBCDĐEÈÉẺẼẸÊỀẾỂỄỆGHIÌÍỈĨỊKLMNOÒÓỎÕỌÔỒỐỔỖỘƠỜỚỞỠỢPQRSTUÙÚỦŨỤƯỪỨỬỮỰVXY -.,/():
recognizer_blank_index=0
recognizer_num_classes=192

# MLflow Model Registry
mlflow_tracking_uri=http://localhost:5000
mlflow_model_name_detection=yolo_detector
mlflow_model_name_recognizer=vit_ctc_deepseek
