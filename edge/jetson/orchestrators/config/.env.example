# Copy to .env and adjust values for the target Jetson/runtime environment.
# Do not commit real database passwords or other credentials.

# Logging and job-control runtime
LOG_LEVEL=INFO
LOG_FORMAT=text
JOB_CONTROL_SERVER_ID=jetson-local
JOB_CONTROL_POLL_INTERVAL_MS=2000

# Python inference runtime (directory is relative to edge/jetson/orchestrators)
INFERENCE_RUNTIME_DIRECTORY=../inference-runtime
INFERENCE_RUNTIME_UV_PATH=uv
INFERENCE_RUNTIME_MODULE=src.entrypoints.inference_daemon.main
INFERENCE_RUNTIME_DISPLAY=true

# Deploy-model and Triton
DOCKER_PATH=docker
TRITON_IMAGE=nvcr.io/nvidia/tritonserver:24.07-py3
TRITON_MODEL_REPOSITORY_PATH=edge/jetson/triton
TRITON_IP=0.0.0.0
TRITON_HOST_PORT=8000
TRITON_MODEL_DETECTOR_PATH_RAW=data/checkpoint/yolo/weights/best.pt
TRITON_MODEL_DETECTOR_PATH_ONNX=artifacts/onnx/detection.onnx
TRITON_MODEL_DETECTOR_PATH_TRT=edge/jetson/triton/detector/1/detection.plan
TRITON_MODEL_DETECTOR_NAME=detector
TRITON_MODEL_DETECTOR_VERSION=1
TRITON_MODEL_RECOGNIZER_PATH_RAW=data/checkpoint_recognizer/best_cer.pt
TRITON_MODEL_RECOGNIZER_PATH_ONNX=artifacts/onnx/recognizer.onnx
TRITON_MODEL_RECOGNIZER_PATH_TRT=edge/jetson/triton/recognizer/1/recognizer.plan
TRITON_MODEL_RECOGNIZER_NAME=recognizer
TRITON_MODEL_RECOGNIZER_VERSION=1

# TensorRT export
EXPORT_TENSORRT_TRITON_DOCKER_ENV_FILE=config/.env
EXPORT_TENSORRT_TRITON_DOCKER_COMPOSE_FILE=deploy/docker/compose/dockercompose.triton.yaml
EXPORT_TENSORRT_TRITON_BUILDER_PROFILE_FORMAT=%s-builder
EXPORT_TENSORRT_TRITON_BUILDER_SERVICE_NAME_FORMAT=triton_builder_%s

# PostgreSQL: replace POSTGRES_PASSWORD for non-local environments.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=overwatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_MIN_CONNECTIONS=1
POSTGRES_MAX_CONNECTIONS=10

# Kafka broker and common client settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_CLIENT_ID_PREFIX=job-control
kafka_consumer_auto_offset_reset=latest
kafka_consumer_enable_auto_commit=false
kafka_consumer_session_timeout_ms=45000
kafka_consumer_max_poll_interval_ms=300000
kafka_producer_acks=all
kafka_producer_enable_idempotence=true
kafka_producer_retries=3
kafka_producer_linger_ms=5
kafka_producer_retry_backoff_ms=1000
kafka_producer_compression_type=snappy

# Kafka job routing
kafka_jobs_deploy_model_topic=edge.model.deploy.jobs
kafka_jobs_deploy_model_group_id=edge-deploy-model
kafka_jobs_deploy_model_consumer_max_poll_interval_ms=300000
kafka_jobs_export_tensorrt_topic=edge.model.export.jobs
kafka_jobs_export_tensorrt_group_id=edge-export-tensorrt
kafka_jobs_export_tensorrt_consumer_max_poll_interval_ms=900000
kafka_jobs_inference_runtime_topic=edge.inference.runtime.jobs
kafka_jobs_inference_runtime_group_id=edge-inference-runtime
