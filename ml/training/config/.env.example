RECOG_TRANSFORM_TRAIN_CONTRAST=0.12
RECOG_TRANSFORM_TRAIN_SATURATION=0.0
RECOG_TRANSFORM_TRAIN_HUE=0.0
RECOG_TRANSFORM_TRAIN_P_GRAYSCALE=0.05
RECOG_TRANSFORM_TRAIN_BLUR_KERNEL_H=3
RECOG_TRANSFORM_TRAIN_BLUR_KERNEL_W=3
