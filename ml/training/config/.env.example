RECOG_NAN_GUARD_CHECK_OUTPUTS=true
RECOG_GRAD_NORM_ENABLED=false
RECOG_GRAD_NORM_MODULE_1=classifier
RECOG_FAST_MODE=true

# I/O
RECOG_SAVE_DIR=artifacts/recognizer
RECOG_TENSORBOARD_DIR=runs/recognizer
RECOG_BEST_CHECKPOINT_NAME=best.pt

# Full Vietnamese charset + digits (used when RECOG_VOCAB_FULL is not empty)
RECOG_VOCAB_FULL=0123456789aàáảãạăằắẳẵặâầấẩẫậbcdđeèéẻẽẹêềếểễệghiìíỉĩịklmnoòóỏõọôồốổỗộơờớởỡợpqrstuùúủũụưừứửữựvxyAÀÁẢÃẠĂẰẮẲẴẶÂẦẤẨẪẬBCDĐEÈÉẺẼẸÊỀẾỂỄỆGHIÌÍỈĨỊKLMNOÒÓỎÕỌÔỒỐỔỖỘƠỜỚỞỠỢPQRSTUÙÚỦŨỤƯỪỨỬỮỰVXY -.,/():
