# Recognizer architecture
RECOG_D_MODEL=512
RECOG_NUM_HEADS=8
RECOG_D_C=256
RECOG_D_C1=256
RECOG_DIM_ROPE=64
RECOG_N_SHARED_EXPERTS=2
RECOG_N_ROUTED_EXPERTS=4
RECOG_TOP_K=2
RECOG_EXPERT_HIDDEN_DIM=1024
RECOG_ATTN_DROP=0.1
RECOG_PROJ_DROP=0.1
RECOG_MOE_DROPOUT=0.1

# Dataset
RECOG_DATA_ROOT=data/recognizer
RECOG_TRAIN_SPLIT=train_data
RECOG_VAL_SPLIT=test_data
