RECOG_TRANSFORM_TRAIN_STD_B=0.225
RECOG_TRANSFORM_VAL_MEAN_R=0.485
RECOG_TRANSFORM_VAL_MEAN_G=0.456
RECOG_TRANSFORM_VAL_MEAN_B=0.406
RECOG_TRANSFORM_VAL_STD_R=0.229
RECOG_TRANSFORM_VAL_STD_G=0.224
RECOG_TRANSFORM_VAL_STD_B=0.225

# Dataloader
RECOG_BATCH_SIZE=640
RECOG_SHUFFLE=true
RECOG_NUM_WORKERS=4
RECOG_PIN_MEMORY=true
RECOG_DROP_LAST=false
RECOG_PERSISTENT_WORKERS=true

# Optimizer / loss / loop
RECOG_LR=0.00025
RECOG_WEIGHT_DECAY=0.00005
RECOG_AMP_ENABLED=true
RECOG_AMP_DTYPE=float16
RECOG_GRAD_ACCUM_STEPS=2
RECOG_SCHED_ENABLED=true
RECOG_SCHED_WARMUP_EPOCHS=3
RECOG_SCHED_MIN_LR_RATIO=0.1
RECOG_BACKBONE_UNFREEZE_CLASSIFIER=false
RECOG_BACKBONE_UNFREEZE_NUM_LAYERS=2
RECOG_CTC_BLANK=0
RECOG_CTC_ZERO_INFINITY=true
RECOG_AUX_LOSS_WEIGHT=0.01
RECOG_EPOCHS=200
RECOG_EVAL_EVERY_N_EPOCHS=5
RECOG_GRAD_CLIP_NORM=2.0

# Hooks
RECOG_TB_LOG_EVERY_N_STEPS=100
RECOG_TB_LOG_LR_EVERY_N_STEPS=100
RECOG_TB_FLUSH_EVERY_N_STEPS=500
RECOG_TB_LOG_HIST_EVERY_N_STEPS=0
RECOG_TB_MAX_MODULES=200
RECOG_TB_LEAF_ONLY=true
RECOG_NAN_GUARD_ENABLED=true
