RECOG_TRANSFORM_TRAIN_BLUR_SIGMA_MAX=0.3
RECOG_TRANSFORM_TRAIN_AFFINE_DEGREES=1.0
RECOG_TRANSFORM_TRAIN_AFFINE_TRANSLATE_H=0.01
RECOG_TRANSFORM_TRAIN_AFFINE_TRANSLATE_W=0.01
