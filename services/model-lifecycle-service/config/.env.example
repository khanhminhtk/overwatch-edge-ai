grpc_model_lifecycle_orchestrator_host=0.0.0.0
grpc_model_lifecycle_orchestrator_port=50051
object_storage_grpc_host=localhost
object_storage_grpc_port=50001
ip_host_minio_service=localhost
port_minio_service=50001
refesh_token_minio_service=your_minio_refresh_token_here
artifact_recognizer_file_path=/path/to/checkpoint_recognizer
artifact_detection_file_path=/path/to/checkpoint
data_raw_recognizer=/path/to/training/data/recognizer
data_raw_detection=/path/to/training/data/detection
data_train_recognizer_version=/path/to/training/data/recognizer/train_data
data_text_recognizer_version=/path/to/training/data/recognizer/text_data
data_train_detection_version=/path/to/training/data/detection
data_text_detection_version=/path/to/training/data/detection/train/labels
image_inferences_file_path=/path/to/data/runtime/image_inferences
image_raw_inferences_file_path=/path/to/data/runtime/image_raw_inferences
image_label_inferences_file_path=/path/to/data/runtime/image_label_inferences
grpc_ca_cert_path=/path/to/certs/server.crt

# Kafka configuration
kafka_bootstrap_servers=localhost:9092
kafka_security_protocol=PLAINTEXT
kafka_client_id_prefix=model-lifecycle-service-server

kafka_consumer_auto_offset_reset=earliest
kafka_consumer_enable_auto_commit=false
kafka_consumer_session_timeout_ms=45000
kafka_consumer_max_poll_interval_ms=300000

kafka_producer_acks=all
kafka_producer_enable_idempotence=true
kafka_producer_retries=10
kafka_producer_linger_ms=5
kafka_producer_retry_backoff_ms=1000
kafka_producer_compression_type=snappy

kafka_jobs_training_topic=model.lifecycle.training
kafka_jobs_training_group_id=model-lifecycle-training
kafka_jobs_training_consumer_max_poll_interval_ms=300000

kafka_jobs_dataset_topic=model.lifecycle.dataset
kafka_jobs_dataset_group_id=model-lifecycle-dataset
kafka_jobs_dataset_consumer_max_poll_interval_ms=300000

kafka_jobs_continual_learning_topic=model.lifecycle.continual.learning
kafka_jobs_continual_learning_group_id=model-lifecycle-continual-learning
kafka_jobs_continual_learning_consumer_max_poll_interval_ms=300000
kafka_jobs_result_topic=model.lifecycle.jobs.result
kafka_jobs_lifecycle_topic=model.lifecycle.lifecycle
kafka_jobs_lifecycle_group_id=model-lifecycle-lifecycle
kafka_jobs_lifecycle_consumer_max_poll_interval_ms=300000

job_processing_reclaim_timeout_seconds=300
job_processing_reclaim_timeout_seconds_training=1800
job_processing_reclaim_timeout_seconds_dataset=900
job_processing_reclaim_timeout_seconds_continual_learning=300
job_processing_reclaim_timeout_seconds_export_onnx=1800
job_processing_reclaim_timeout_seconds_mlflow_download=900
job_processing_reclaim_timeout_seconds_mlflow_tracking=1800

kafka_jobs_export_recognizer_tensorrt_topic=model.lifecycle.export.recognizer.tensorrt
kafka_jobs_export_recognizer_tensorrt_group_id=model-lifecycle-export-recognizer-tensorrt
kafka_jobs_export_recognizer_tensorrt_consumer_max_poll_interval_ms=300000

kafka_jobs_export_yolo_tensorrt_topic=model.lifecycle.export.yolo.tensorrt
kafka_jobs_export_yolo_tensorrt_group_id=model-lifecycle-export-yolo-tensorrt
kafka_jobs_export_yolo_tensorrt_consumer_max_poll_interval_ms=300000

kafka_jobs_export_onnx_topic=model.lifecycle.export.onnx
kafka_jobs_export_onnx_group_id=model-lifecycle-export-onnx
kafka_jobs_export_onnx_consumer_max_poll_interval_ms=300000

kafka_jobs_mlflow_download_topic=model.lifecycle.mlflow.download
kafka_jobs_mlflow_download_group_id=model-lifecycle-mlflow-download
kafka_jobs_mlflow_download_consumer_max_poll_interval_ms=300000

kafka_jobs_mlflow_tracking_topic=model.lifecycle.mlflow.tracking
kafka_jobs_mlflow_tracking_group_id=model-lifecycle-mlflow-tracking
kafka_jobs_mlflow_tracking_consumer_max_poll_interval_ms=300000

kafka_jobs_mlflow_download_detection_topic=model.lifecycle.mlflow.download.detection
kafka_jobs_mlflow_download_detection_group_id=model-lifecycle-mlflow-download-detection
kafka_jobs_mlflow_download_detection_consumer_max_poll_interval_ms=300000

kafka_jobs_mlflow_download_recognizer_topic=model.lifecycle.mlflow.download.recognizer
kafka_jobs_mlflow_download_recognizer_group_id=model-lifecycle-mlflow-download-recognizer
kafka_jobs_mlflow_download_recognizer_consumer_max_poll_interval_ms=300000

DETECT_TRAINING_CONFIG_PATH=ml/training/config/training/yolo/config.yaml
DETECT_TRAINING_ENV_PATH=ml/training/config/.env.example
RECOG_TRAINING_CONFIG_PATH=ml/training/config/training/recognizer_ctc.yaml
RECOG_TRAINING_ENV_PATH=ml/training/config/.env.example
# Repo-relative directory written by export daemon and mounted by Triton builders.
ONNX_EXPORT_DIR=artifacts/onnx

# MLflow configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_DEPLOYMENT_STAGE=training
GPU_HOST_NAME=unknown_host
GPU_NAME=your_gpu_name
GPU_MEMORY_GB=0
CUDA_VERSION=your_cuda_version
GPU_DRIVER_VERSION=your_driver_version
FRAMEWORK_NAME=pytorch

MLFLOW_MODEL_NAME_DETECTION=yolo_detector
DETECT_MODEL_TYPE=detector
DETECT_TASK_NAME=detection
DETECT_BEST_CHECKPOINT_NAME=best.pt
DETECT_LAST_CHECKPOINT_NAME=last.pt
DETECT_DATASET_NAME=unknown_dataset
DETECT_RESULTS_CSV_PATH=data/checkpoint/yolo/results.csv
DETECT_DATASET_ZIP_PATH=ml/training/data/detection.zip
DETECT_MANIFEST_PATH=ml/training/data/god_dataset_detection_dataset_manifest.json
DETECT_SAVE_DIR=data/checkpoint/yolo/weights
PIPELINE_NAME_DETECTION=unknown_pipeline
PIPELINE_RUN_ID_DETECTION=unknown_pipeline_run_id

MLFLOW_MODEL_NAME_RECOGNIZER=vit_ctc_deepseek
RECOG_TENSORBOARD_DIR=data/checkpoint_recognizer/runs/recognizer
RECOG_MODEL_TYPE=recognizer
RECOG_TASK_NAME=recognition
RECOG_BEST_CHECKPOINT_NAME=best_cer.pt
RECOG_LAST_CHECKPOINT_NAME=last_checkpoint.pt
RECOG_DATASET_NAME=unknown_dataset
RECOG_DATASET_ZIP_PATH=ml/training/data/recognizer.zip
RECOG_MANIFEST_PATH=ml/training/data/recognition_dataset_manifest.json
RECOG_SAVE_DIR=data/checkpoint_recognizer
PIPELINE_NAME_RECOGNIZER=unknown_pipeline
PIPELINE_RUN_ID_RECOGNIZER=unknown_pipeline_run_id

# PostgreSQL configuration
postgresql_host=localhost
postgresql_port=5432
postgresql_database=your_database
postgresql_user=your_user
postgresql_password=your_password

# Google Vision configuration
google_vision_certificate_path=/path/to/your-service-account.json
google_vision_image_test_path=/path/to/test/image.jpg

# Training configuration
TRAINING_MODE=local
